# Request a free key at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Runtime settings
PORTWATCH_DATABASE_PATH=data/portwatch.duckdb
PORTWATCH_PROJECT_CONFIG_PATH=config/portwatch.yml
PORTWATCH_COMPANY_REGISTRY_PATH=config/company_exposures.yml
PORTWATCH_HTTP_TIMEOUT_SECONDS=30
# SEC requires a declared organization and contact email in automated User-Agent headers.
PORTWATCH_USER_AGENT=PortWatch/0.1 (research; contact=your-email@example.com)
PORTWATCH_SEC_REQUEST_INTERVAL_SECONDS=0.12
PORTWATCH_LOG_LEVEL=INFO
